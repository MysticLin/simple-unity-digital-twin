+std::string CaiyuWebServer::BuildTelemetryJson() const {
+    std::string json;
+    json.reserve(320);
+
+    const DeviceState state = Application::GetInstance().GetDeviceState();
+
+    json += "{\"type\":\"telemetry\",\"t\":";
+    json += std::to_string(static_cast<uint32_t>(esp_timer_get_time() / 1000));
+    json += ",\"state\":\"";
+    json += DeviceStateMachine::GetStateName(state);
+    json += "\",\"voice\":";
+    json += Application::GetInstance().IsVoiceDetected() ? "true" : "false";
+
+    if (display_ != nullptr) {
+        json += ",\"emotion\":\"";
+        json += caiyu::EmotionToName(display_->current_emotion());
+        json += '"';
+    }
+
+    if (actionments_ != nullptr) {
+        json += ",\"action\":\"";
+        json += caiyu::Actionments::ActionName(actionments_->current());
+        json += "\",\"busy\":";
+        json += actionments_->busy() ? "true" : "false";
+        json += ",\"drive\":\"";
+        json += caiyu::Actionments::DriveName(actionments_->drive());
+        json += "\",\"speed\":";
+        json += std::to_string(actionments_->speed_percent());
+
+        json += ",\"legs\":[";
+        for (int i = 0; i < caiyu::kLegCount; ++i) {
+            if (i != 0) {
+                json += ',';
+            }
+            json += std::to_string(actionments_->leg_angle(i));
+        }
+        json += ']';
+
+        json += ",\"trims\":[";
+        for (int i = 0; i < caiyu::kLegCount; ++i) {
+            if (i != 0) {
+                json += ',';
+            }
+            json += std::to_string(actionments_->leg_trim(i));
+        }
+        json += ']';
+    }
+
+    if (strip_ != nullptr) {
+        uint8_t r = 0;
+        uint8_t g = 0;
+        uint8_t b = 0;
+        strip_->GetColor(r, g, b);
+
+        json += ",\"lamp\":{\"on\":";
+        json += strip_->IsOn() ? "true" : "false";
+        json += ",\"mode\":";
+        json += std::to_string(strip_->Mode());
+        json += ",\"brightness\":";
+        json += std::to_string(static_cast<int>(strip_->Brightness()));
+        json += ",\"speed\":";
+        json += std::to_string(strip_->speed_percent());
+        json += ",\"r\":";
+        json += std::to_string(static_cast<int>(r));
+        json += ",\"g\":";
+        json += std::to_string(static_cast<int>(g));
+        json += ",\"b\":";
+        json += std::to_string(static_cast<int>(b));
+        json += '}';
+    }
+
+    json += '}';
+    return json;
+}
+
+void CaiyuWebServer::PushTelemetry() {
+    if (!HasTelemetryClients()) {
+        return;
+    }
+
+    const int hz = (telemetry_hz_ > 0) ? telemetry_hz_ : kDefaultTelemetryHz;
+    const uint32_t interval_ms = static_cast<uint32_t>(1000 / hz);
+    const uint32_t now_ms = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    if (last_telemetry_ms_ != 0 && (now_ms - last_telemetry_ms_) < interval_ms) {
+        return;
+    }
+    last_telemetry_ms_ = now_ms;
+
+    BroadcastTelemetry(BuildTelemetryJson());
+}
+
+void CaiyuWebServer::HandleTelemetry(httpd_req_t* req, const cJSON* root) {
+    const int fd = httpd_req_to_sockfd(req);
+
+    const cJSON* enable = cJSON_GetObjectItem(root, "enable");
+    const bool off = cJSON_IsBool(enable) && !cJSON_IsTrue(enable);
+
+    if (off) {
+        SetClientTelemetry(fd, false);
+    } else {
+        const cJSON* hz_item = cJSON_GetObjectItem(root, "hz");
+        if (cJSON_IsNumber(hz_item)) {
+            int hz = hz_item->valueint;
+            if (hz < 1) {
+                hz = 1;
+            } else if (hz > kMaxTelemetryHz) {
+                hz = kMaxTelemetryHz;
+            }
+            telemetry_hz_ = hz;
+        }
+        AddClient(fd);
+        SetClientTelemetry(fd, true);
+    }
+
+    // 无论订阅还是退订，都先回一帧当前姿态：Unity 连上后立刻有初始位形。
+    SendText(req, BuildTelemetryJson());
+}
