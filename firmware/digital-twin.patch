+// 把一条文本帧异步派发给给定的 fd 列表（0 表示空槽）。调用方负责先把 fd 快照出来，
+// 避免在持锁状态下 malloc / 排 work。
+void SendJsonToFds(httpd_handle_t server, const int* fds, size_t count, const std::string& message) {
+    if (server == nullptr) {
+        return;
+    }
+    for (size_t i = 0; i < count; ++i) {
+        if (fds[i] == 0) {
+            continue;
+        }
+        auto* job = static_cast<ChatBroadcastJob*>(malloc(sizeof(ChatBroadcastJob)));
+        auto* payload = static_cast<char*>(malloc(message.size()));
+        if (job == nullptr || payload == nullptr) {
+            free(job);
+            free(payload);
+            continue;
+        }
+        memcpy(payload, message.c_str(), message.size());
+        job->server = server;
+        job->fd = fds[i];
+        job->payload = payload;
+        job->len = message.size();
+        if (httpd_queue_work(server, ChatBroadcastJobFn, job) != ESP_OK) {
+            free(payload);
+            free(job);
+        }
+    }
 }
 
